# Copy to `.env` and fill in. `.env` is gitignored — never commit real
# credentials.
#
# Nothing in the app auto-loads this file (there's no python-dotenv
# dependency); it's sourced by the launch command in
# .claude/skills/run-servers/SKILL.md before uvicorn starts. If you launch
# uvicorn some other way, export these yourself.


# ===========================================================================
# 1. Which provider serves the LLM features
# ===========================================================================
# "groq" (default) or "bedrock". Unset behaves as "groq", so a
# GROQ_API_KEY on its own is enough. Set it to "bedrock" to use AWS.
#
# The same key and model also serve OCR: photographs and scans are
# transcribed through the provider's vision path, so reading paper needs
# no second service configured.
COMPANYSIM_LLM_PROVIDER=groq


# ===========================================================================
# 2a. Groq — the default provider
# ===========================================================================
# Free tier, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# Optional override. The default model was chosen to do BOTH jobs: it
# honours response_format json_object (which extraction needs) and it
# accepts image input (which OCR needs). Swapping to a text-only model
# silently disables reading paper, so check both before changing it:
#
#   curl -H "Authorization: Bearer $GROQ_API_KEY" \
#        https://api.groq.com/openai/v1/models
#
# Models are retired without notice — the one this project originally
# shipped with (llama-3.3-70b-versatile) now 404s.
# COMPANYSIM_GROQ_MODEL_ID=


# ===========================================================================
# 2b. AWS Bedrock — only when COMPANYSIM_LLM_PROVIDER=bedrock
# ===========================================================================
# Credentials resolve through boto3's standard chain. Three options, and
# only one of them puts secrets in this file:
#
#   1. An IAM role (EC2/ECS/Lambda instance profile) — set NOTHING here
#      except the region. The right answer in production: no key material
#      on disk, and rotation is AWS's problem rather than yours.
#   2. A named profile from `aws configure` — set AWS_PROFILE instead.
#   3. Static keys — the two variables below. Fine for a laptop.
#
# The region is NOT optional: Bedrock's endpoint is regional, and an unset
# region fails with NoRegionError rather than defaulting.
# AWS_DEFAULT_REGION=eu-west-2

# Option 3 only — leave blank if you use a role or a profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only for temporary/STS credentials

# Option 2 only.
# AWS_PROFILE=

# VERIFY FOR YOUR ACCOUNT before first use — availability depends on the
# region and on which models the account has been granted:
#
#   aws bedrock list-inference-profiles --region eu-west-2
#
# In EU regions Claude is served through cross-region inference profiles,
# whose ids carry an "eu." prefix. A bare "anthropic.claude-..." id is
# rejected there with a ValidationException — the most common first-run
# failure. See docs/bedrock-setup.md.
# COMPANYSIM_BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-20250514-v1:0


# ===========================================================================
# 2c. OCR — reading photographed and scanned paper
# ===========================================================================
# Unset auto-selects whichever service is already configured above: Groq
# when a key is set, else Bedrock when AWS is, else a local Tesseract if
# one is installed. Values: groq | bedrock | textract | tesseract | off.
#
# Only ever invoked when an image is uploaded, or when a PDF turns out to
# have no text layer. Tokens are metered under the "ocr" feature, so
# transcription cost stays separable from extraction cost.
# COMPANYSIM_OCR_PROVIDER=


# ===========================================================================
# 3. Which features are on
# ===========================================================================
# Each is independent; set only the ones you want. Any value other than
# 1/true/yes counts as off. All of them need a working provider above.

# Free-text document extraction: performance reviews, resignation letters,
# offer letters and CVs on the Document Ingestion page. Without it those
# uploads are stored and parked as "needs review" — rosters still parse,
# they never need a provider at all.
COMPANYSIM_LLM_INGEST=1

# LLM-written exit notes during a Diagnose run (falls back to the template
# generator per-note on any failure).
COMPANYSIM_LLM_EXIT_NOTES=0

# The floating "Ask Vantage" chat widget (no fallback — shows a
# "not configured" message when off).
COMPANYSIM_LLM_CHAT=0
