# Copy to `.env` and fill in. `.env` is gitignored — never commit real
# credentials.
#
# Nothing in the app auto-loads this file (there's no python-dotenv
# dependency); it's sourced by the launch command in
# .claude/skills/run-servers/SKILL.md before uvicorn starts. If you launch
# uvicorn some other way, export these yourself.


# ===========================================================================
# 1. Which provider serves the three LLM features
# ===========================================================================
# "bedrock" (default) or "groq". Unset behaves as "bedrock" — the
# deployment target — so configuring AWS credentials is sufficient on its
# own. Set it to "groq" to use Groq instead.
COMPANYSIM_LLM_PROVIDER=bedrock


# ===========================================================================
# 2a. AWS Bedrock — the default provider
# ===========================================================================
# Credentials resolve through boto3's standard chain. That means you have
# three options and only one of them puts secrets in this file:
#
#   1. An IAM role (EC2/ECS/Lambda instance profile) — set NOTHING here
#      except the region. This is the right answer in production: no key
#      material on disk, and rotation is AWS's problem rather than yours.
#   2. A named profile from `aws configure` — set AWS_PROFILE instead of
#      the keys below.
#   3. Static keys — the two variables below. Fine for a laptop.
#
# The region is NOT optional for Bedrock: the endpoint is regional, and an
# unset region fails with NoRegionError rather than defaulting.
AWS_DEFAULT_REGION=eu-west-2

# Option 3 only — leave blank if you use a role or a profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only if you are using temporary/STS credentials.
# AWS_SESSION_TOKEN=

# Option 2 only.
# AWS_PROFILE=

# The Bedrock model id. VERIFY THIS FOR YOUR ACCOUNT before first use —
# availability depends on both the region and which models your account
# has been granted access to:
#
#   aws bedrock list-inference-profiles --region eu-west-2 \
#     --query "inferenceProfileSummaries[].inferenceProfileId"
#
# In EU regions Claude is served through cross-region inference profiles,
# whose ids carry an "eu." prefix. A bare "anthropic.claude-..." id is
# rejected there with a ValidationException — the most common first-run
# failure. Run `python scripts/check_llm_provider.py` to confirm.
COMPANYSIM_BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-20250514-v1:0


# ===========================================================================
# 2b. Groq — only used when COMPANYSIM_LLM_PROVIDER=groq
# ===========================================================================
# Free tier, no card: https://console.groq.com/keys
# Leave blank unless you have set the provider to "groq" above — a key here
# is ignored under the Bedrock default (the status endpoint will say so).
GROQ_API_KEY=
# Optional override; defaults to llama-3.3-70b-versatile.
# COMPANYSIM_GROQ_MODEL_ID=


# ===========================================================================
# 3. Which features are on
# ===========================================================================
# Each is independent; set only the ones you want. Any value other than
# 1/true/yes counts as off. All of them need a working provider above.

# Free-text document extraction: performance reviews, resignation letters,
# offer letters and CVs on the Document Ingestion page. Without it those
# uploads are stored and parked as "needs review" — rosters still parse,
# they never need a provider at all.
COMPANYSIM_LLM_INGEST=1

# LLM-written exit notes during a Diagnose run (falls back to the template
# generator per-note on any failure).
COMPANYSIM_LLM_EXIT_NOTES=0

# The floating "Ask Vantage" chat widget (no fallback — shows a
# "not configured" message when off).
COMPANYSIM_LLM_CHAT=0
